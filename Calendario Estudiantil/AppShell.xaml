<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Calendario_Estudiantil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Calendario_Estudiantil"
    Shell.FlyoutBehavior="Flyout"
    Title="Calendario Estudiantil">

    <Shell.FlyoutHeader>
        <StackLayout BackgroundColor="{AppThemeBinding Light=#1544A2, Dark=#1C1B1F}" Padding="15">
            <Label Text="📅 Calendario Estudiantil" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
        </StackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutContent>
        <StackLayout Padding="15">
            <Label Text="Navegación" FontAttributes="Bold" Margin="0,0,0,10"/>
            <Button Text="📅 Calendario" Clicked="OnNavigateSchedule" Margin="0,2"/>
            <Button Text="📋 Tareas" Clicked="OnNavigateTasks" Margin="0,2"/>
            <Button Text="📚 Materias" Clicked="OnNavigateSubjects" Margin="0,2"/>
        </StackLayout>
    </Shell.FlyoutContent>

    <ShellContent Title="Calendario" Route="SchedulePage" ContentTemplate="{DataTemplate local:Views.SchedulePage}"/>
    <ShellContent Title="Tareas" Route="TasksPage" ContentTemplate="{DataTemplate local:Views.TasksPage}"/>
    <ShellContent Title="Materias" Route="SubjectsPage" ContentTemplate="{DataTemplate local:Views.SubjectsPage}"/>

</Shell>