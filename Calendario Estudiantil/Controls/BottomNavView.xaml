<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             x:Class="Calendario_Estudiantil.Controls.BottomNavView"
             x:Name="NavView">

    <Frame Margin="5,0,5,5" Padding="0" CornerRadius="12"
           BackgroundColor="{AppThemeBinding Light={x:Static config:AppConstants.AccentLight}, Dark=#2C2C2C}"
           BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}" HasShadow="False">
        <Grid ColumnSpacing="0" HeightRequest="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Calendario -->
            <Grid Grid.Column="0">
                <VerticalStackLayout x:Name="ScheduleTab" 
                                     HorizontalOptions="Fill" VerticalOptions="Fill"
                                     Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnScheduleClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="ScheduleIcon" HorizontalOptions="Center" 
                           Margin="0,6,0,0" WidthRequest="22" HeightRequest="22"/>
                    <Label x:Name="ScheduleLabel" Text="Calendario" FontSize="10"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <BoxView x:Name="ScheduleIndicator" VerticalOptions="End"
                         HeightRequest="3" Margin="20,0"
                         BackgroundColor="{x:Static config:AppConstants.Accent}"
                         IsVisible="False"/>
            </Grid>

            <!-- Tareas -->
            <Grid Grid.Column="1">
                <VerticalStackLayout x:Name="TasksTab" 
                                     HorizontalOptions="Fill" VerticalOptions="Fill"
                                     Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTasksClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="TasksIcon" HorizontalOptions="Center" 
                           Margin="0,6,0,0" WidthRequest="22" HeightRequest="22"/>
                    <Label x:Name="TasksLabel" Text="Tareas" FontSize="10"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <BoxView x:Name="TasksIndicator" VerticalOptions="End"
                         HeightRequest="3" Margin="20,0"
                         BackgroundColor="{x:Static config:AppConstants.Accent}"
                         IsVisible="False"/>
            </Grid>

            <!-- Materias -->
            <Grid Grid.Column="2">
                <VerticalStackLayout x:Name="SubjectsTab" 
                                     HorizontalOptions="Fill" VerticalOptions="Fill"
                                     Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSubjectsClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="SubjectsIcon" HorizontalOptions="Center" 
                           Margin="0,6,0,0" WidthRequest="22" HeightRequest="22"/>
                    <Label x:Name="SubjectsLabel" Text="Materias" FontSize="10"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <BoxView x:Name="SubjectsIndicator" VerticalOptions="End"
                         HeightRequest="3" Margin="20,0"
                         BackgroundColor="{x:Static config:AppConstants.Accent}"
                         IsVisible="False"/>
            </Grid>
        </Grid>
    </Frame>
</ContentView>
