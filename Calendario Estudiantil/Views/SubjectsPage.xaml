<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
             x:Class="Calendario_Estudiantil.Views.SubjectsPage"
             Title="Materias"
             Padding="0"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="CardGradientLight" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#F5F7FA"/>
            <GradientStop Offset="1.0" Color="#E8F0FE"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientDark" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#1E1E1E"/>
            <GradientStop Offset="1.0" Color="#2A2A2A"/>
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header limpio -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar circular -->
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       Padding="0" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" Margin="0,0,12,0">
                    <Label Text="M" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                
                <!-- Título y subtítulo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Mis Materias" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                    <Label x:Name="SubtitleLabel" Text="CICLO LECTIVO 2026" FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#707070}"/>
                </VerticalStackLayout>
                
                <!-- Ícono configuración -->
                <Button Grid.Column="2" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnSettingsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF6AA;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>
                
                <!-- Ícono notificaciones -->
                <Button Grid.Column="3" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnNotificationsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF115;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Frame>

        <!-- Lista de materias -->
        <CollectionView Grid.Row="1" x:Name="SubjectsList"
                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}"
                        VerticalScrollBarVisibility="Always"
                        Margin="0,0,0,70">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12" Padding="0" Margin="16,0"
                           HasShadow="True" BorderColor="Transparent">
                        <Frame.Background>
                            <AppThemeBinding Light="{StaticResource CardGradientLight}" 
                                             Dark="{StaticResource CardGradientDark}"/>
                        </Frame.Background>
                        <Frame.Shadow>
                            <Shadow Brush="Black" Opacity="0.15" Offset="0,4" Radius="8"/>
                        </Frame.Shadow>
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubjectTapped"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Barra de color lateral -->
                            <BoxView Grid.Column="0" Color="{Binding ColorHex}" 
                                     HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True"/>
                            
                            <!-- Contenido -->
                            <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="4" InputTransparent="True">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" InputTransparent="True"/>
                                <Label Text="Tocá para ver horarios" FontSize="13" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" InputTransparent="True"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text=" No hay materias. Agregá una nueva." 
                       FontSize="16" TextColor="{AppThemeBinding Light=#888888, Dark=#707070}" 
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- FAB para agregar -->
        <Button Grid.Row="1" Text="+" 
                FontSize="28" FontAttributes="Bold"
                WidthRequest="56" HeightRequest="56" CornerRadius="16"
                BackgroundColor="{x:Static config:AppConstants.Accent}"
                TextColor="White"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,16,16"
                Clicked="OnAddSubject"
                Shadow="{Shadow Brush='Black', Opacity=0.3, Offset='0,2', Radius=4}"/>

        <!-- Barra de navegación inferior -->
        <controls:BottomNavView Grid.Row="2" ActiveTab="Subjects"/>
    </Grid>
</ContentPage>
