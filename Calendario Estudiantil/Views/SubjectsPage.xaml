<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendario_Estudiantil.Views.SubjectsPage"
             Title="Materias">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <CollectionView x:Name="SubjectsList" EmptyView="Sin materias. Seleccioná una carrera.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10">
                            <Label Text="{Binding Name}" FontSize="Medium"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Button Grid.Row="1" Text="+ Agregar Materia" Clicked="OnAddSubject" Margin="0,10,0,0"/>
    </Grid>

</ContentPage>