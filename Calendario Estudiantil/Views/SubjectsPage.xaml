<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
             x:Class="Calendario_Estudiantil.Views.SubjectsPage"
             Title="Materias"
             Padding="0"
             NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header limpio -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="White"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar circular -->
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       Padding="0" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" Margin="0,0,12,0">
                    <Label Text="M" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                
                <!-- Título y subtítulo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Mis Materias" FontSize="20" FontAttributes="Bold"
                           TextColor="#1A1A1A"/>
                    <Label Text="CICLO LECTIVO 2026" FontSize="12"
                           TextColor="#888888"/>
                </VerticalStackLayout>
                
                <!-- Ícono búsqueda -->
                <Button Grid.Column="2" Text="🔍" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        FontSize="18" Padding="0" TextColor="#666666"
                        Clicked="OnSearchClicked"/>
                
                <!-- Ícono notificaciones -->
                <Button Grid.Column="3" Text="🔔" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        FontSize="18" Padding="0" TextColor="#666666"
                        Clicked="OnNotificationsClicked"/>
            </Grid>
        </Frame>

        <!-- Barra de búsqueda (oculta por defecto) -->
        <Frame Grid.Row="1" x:Name="SearchBarFrame" IsVisible="False"
               Margin="16,0,16,8" Padding="12,8" CornerRadius="12"
               BackgroundColor="#F5F5F5" BorderColor="Transparent" HasShadow="False">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Entry Grid.Column="0" x:Name="SearchEntry" 
                       Placeholder="Buscar materia..."
                       Text="{Binding SearchQuery}"
                       TextChanged="OnSearchTextChanged"
                       FontSize="14" BackgroundColor="Transparent"/>
                
                <Button Grid.Column="1" Text="✕" 
                        BackgroundColor="Transparent" TextColor="Gray"
                        WidthRequest="32" HeightRequest="32" CornerRadius="16"
                        FontSize="14" Padding="0"
                        Clicked="OnClearSearchClicked"/>
            </Grid>
        </Frame>

        <!-- Lista de materias -->
        <CollectionView Grid.Row="2" x:Name="SubjectsList"
                        BackgroundColor="#F8F9FA"
                        VerticalScrollBarVisibility="Always">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="0" Margin="16,0"
                           HasShadow="True" BorderColor="Transparent">
                        <Frame.Shadow>
                            <Shadow Brush="Black" Opacity="0.15" Offset="0,4" Radius="8"/>
                        </Frame.Shadow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Barra de color lateral -->
                            <BoxView Grid.Column="0" Color="{Binding ColorHex}" 
                                     HorizontalOptions="Fill" VerticalOptions="Fill"/>
                            
                            <!-- Contenido -->
                            <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" 
                                       TextColor="#333333"/>
                                <Label Text="Tocá para ver horarios" FontSize="13" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text=" No hay materias. Agregá una nueva." 
                       FontSize="16" TextColor="Gray" 
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- FAB para agregar -->
        <Button Grid.Row="2" Text="+" 
                FontSize="28" FontAttributes="Bold"
                WidthRequest="56" HeightRequest="56" CornerRadius="16"
                BackgroundColor="{x:Static config:AppConstants.Accent}"
                TextColor="White"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,16,80"
                Clicked="OnAddSubject"
                Shadow="{Shadow Brush='Black', Opacity=0.3, Offset='0,2', Radius=4}"/>

        <!-- Barra de navegación inferior -->
        <controls:BottomNavView Grid.Row="3" ActiveTab="Subjects"/>
    </Grid>
</ContentPage>
