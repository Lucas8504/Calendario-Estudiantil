<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendario_Estudiantil.Views.SubjectSchedulesPage"
             Title="{Binding SubjectName, StringFormat='Horario: {0}'}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Info de la materia -->
        <StackLayout Grid.Row="0" Margin="0,0,0,10">
            <Label Text="{Binding SubjectName}" FontSize="10" FontAttributes="Bold"/>
            <Label Text="Agregá los días y horarios de clase" FontSize="14" TextColor="Gray"/>
        </StackLayout>

        <!-- Lista de horarios -->
        <ScrollView Grid.Row="1">
            <CollectionView x:Name="SchedulesList" EmptyView="Sin horarios. Agregá uno.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="12" BackgroundColor="#F5F5F5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0">
                                    <Label Text="{Binding DayName}" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding TimeDisplay}" FontSize="14" TextColor="Gray"/>
                                </StackLayout>
                                <Button Grid.Column="1" Text="X" Clicked="OnDeleteSchedule"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="#FFCDD2" TextColor="#D32F2F"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Botón agregar -->
        <StackLayout Grid.Row="2">
            <Button Text="+ Agregar Horario" Clicked="OnAddSchedule" Margin="0,10,0,0"/>
            <Button Text="Guardar y Volver" Clicked="OnSave" Margin="0,10,0,0" BackgroundColor="#4CAF50" TextColor="White"/>
        </StackLayout>
    </Grid>
</ContentPage>