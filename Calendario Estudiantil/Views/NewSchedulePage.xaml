<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendario_Estudiantil.Views.NewSchedulePage"
             Title="Agregar Horario">

    <Grid Margin="15">
        <!-- Trampa de foco invisible para evitar que el Picker se abra solo -->
        <Entry x:Name="FocusStealer" HeightRequest="0" Opacity="0" IsReadOnly="True"/>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Label Grid.Row="0" x:Name="PageTitle" Text="Nuevo Horario" FontSize="24" FontAttributes="Bold" Margin="0,0,0,20"/>

        <!-- Día (Cuadrícula de botones) -->
        <VerticalStackLayout Grid.Row="1" Margin="0,0,0,15">
            <Label Text="Día de la semana" FontSize="Medium" FontAttributes="Bold" Margin="0,0,0,10"/>
            <FlexLayout x:Name="DayGrid" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Stretch">
                <!-- Los botones se generan en el code-behind -->
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Hora de inicio -->
        <VerticalStackLayout Grid.Row="2" Margin="0,0,0,15">
            <Label Text="Hora de inicio" FontSize="Medium" FontAttributes="Bold"/>
            <TimePicker x:Name="StartTimePicker" Format="HH:mm"/>
        </VerticalStackLayout>

        <!-- Hora de fin -->
        <VerticalStackLayout Grid.Row="3" Margin="0,0,0,15">
            <Label Text="Hora de fin" FontSize="Medium" FontAttributes="Bold"/>
            <TimePicker x:Name="EndTimePicker" Format="HH:mm"/>
        </VerticalStackLayout>

        <!-- Botones -->
        <HorizontalStackLayout Grid.Row="5" Spacing="10" HorizontalOptions="Center">
            <Button Text="Cancelar" Clicked="OnCancel" WidthRequest="120"/>
            <Button x:Name="SaveButton" Text="Agregar" Clicked="OnSave" WidthRequest="120" BackgroundColor="#4CAF50" TextColor="White"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>