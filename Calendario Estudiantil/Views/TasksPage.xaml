<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
             xmlns:converters="clr-namespace:Calendario_Estudiantil.Converters"
             x:Class="Calendario_Estudiantil.Views.TasksPage"
             Title="Tareas"
             Padding="0"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="CardGradientLight" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#F5F7FA"/>
            <GradientStop Offset="1.0" Color="#E8F0FE"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientDark" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#1E1E1E"/>
            <GradientStop Offset="1.0" Color="#2A2A2A"/>
        </LinearGradientBrush>
        <converters:HexToColorConverter x:Key="HexToColorConverter"/>
        <converters:TaskStatusToEmojiConverter x:Key="TaskStatusToEmojiConverter"/>
        <converters:SubjectIdToVisibilityConverter x:Key="SubjectIdToVisibilityConverter"/>
    </ContentPage.Resources>

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header limpio -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar circular -->
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       Padding="0" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" Margin="0,0,12,0">
                    <Label Text="T" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                
                <!-- Título y subtítulo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Mis Tareas" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                    <Label x:Name="SubtitleLabel" Text="CICLO LECTIVO 2026" FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#707070}"/>
                </VerticalStackLayout>
                
                <!-- Ícono configuración -->
                <Button Grid.Column="2" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnSettingsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF6AA;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>
                
                <!-- Ícono notificaciones -->
                <Button Grid.Column="3" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnNotificationsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF115;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Frame>

        <!-- Tabs de filtros estilo pill -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}">
            <HorizontalStackLayout x:Name="FilterTabsContainer" 
                                   Spacing="8" Padding="16,8"
                                   HorizontalOptions="Start"/>
        </ScrollView>

        <!-- Lista de tareas -->
        <CollectionView x:Name="TasksCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding Tasks}"
                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="0" CornerRadius="12" HasShadow="True" BorderColor="Transparent">
                        <Frame.Background>
                            <AppThemeBinding Light="{StaticResource CardGradientLight}" 
                                             Dark="{StaticResource CardGradientDark}"/>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTaskTapped"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Barra de color lateral -->
                            <BoxView Grid.Column="0" Color="{Binding SubjectColor}"
                                     HorizontalOptions="Fill" VerticalOptions="Fill"/>

                            <!-- Contenido -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="12,8">
                                <Label Text="{Binding TaskItem.Title}" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                                <Label Text="{Binding TaskItem.DueDate, StringFormat='📅 Vence: {0:dd/MM/yyyy}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#888888, Dark=#A0A0A0}"/>
                                <Label Text="{Binding SubjectName, StringFormat='📚 {0}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#888888, Dark=#A0A0A0}"
                                       IsVisible="{Binding TaskItem.SubjectId, Converter={StaticResource SubjectIdToVisibilityConverter}}"/>
                            </VerticalStackLayout>

                            <!-- Indicador de estado -->
                            <Label Grid.Column="2" Text="{Binding TaskItem.Status, Converter={StaticResource TaskStatusToEmojiConverter}}"
                                   FontSize="18" HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,12,0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="📭 No hay tareas para mostrar" FontSize="16" TextColor="Gray"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- FAB para agregar -->
        <Button Grid.Row="2" Text="+" 
                FontSize="28" FontAttributes="Bold"
                WidthRequest="56" HeightRequest="56" CornerRadius="16"
                BackgroundColor="{x:Static config:AppConstants.Accent}"
                TextColor="White"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,16,16"
                Clicked="OnCreateTask"
                Shadow="{Shadow Brush='Black', Opacity=0.3, Offset='0,2', Radius=4}"/>

        <!-- Barra de navegación inferior -->
        <controls:BottomNavView Grid.Row="3" ActiveTab="Tasks"/>
    </Grid>
</ContentPage>
