<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Calendario_Estudiantil.Views.SubjectPopup"
               Color="Transparent">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            MinimumWidthRequest="300">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Título con icono de editar -->
            <Grid Padding="0,0,15,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título centrado en el espacio disponible -->
                <Label x:Name="TitleLabel"
                       Grid.Column="0"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>

                <!-- Icono de editar materia a la derecha -->
                <Frame Grid.Column="1"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                       Padding="4"
                       CornerRadius="4"
                       HasShadow="False"
                       VerticalOptions="Center">
                    <Label Text="✏️" FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditSubject"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>
            </Grid>

            <!-- Información del horario -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                   CornerRadius="8"
                   Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="DayLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>
                    <Label x:Name="TimeLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Tareas de la materia -->
            <VerticalStackLayout>
                <Label Text="Tareas:"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                <CollectionView x:Name="TasksList"
                                HeightRequest="100">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Title}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#512BD4, Dark=#7B68EE}"
                                   Padding="5"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Botones -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="Tarea"
                        Clicked="OnAddTask"
                        BackgroundColor="#4CAF50"
                        TextColor="White"/>

                <Button Grid.Column="1"
                        Text="✕"
                        Clicked="OnCancel"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
