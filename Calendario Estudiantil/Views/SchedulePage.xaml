<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
              x:Class="Calendario_Estudiantil.Views.SchedulePage"
              Title="Calendario"
              Padding="0"
              NavigationPage.HasNavigationBar="False"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}">

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header limpio -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar circular -->
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       Padding="0" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" Margin="0,0,12,0">
                    <Label Text="C" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <!-- Título y subtítulo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Calendario" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                    <Label x:Name="SubtitleLabel" Text="CICLO LECTIVO 2026" FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#707070}"/>
                </VerticalStackLayout>

                <!-- Ícono configuración -->
                <Button Grid.Column="2" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnSettingsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF6AA;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>

                <!-- Ícono notificaciones -->
                <Button Grid.Column="3" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnNotificationsClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF115;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Frame>

        <!-- Badge de notificaciones -->
        <Frame Grid.Row="0" HorizontalOptions="End" VerticalOptions="Start"
               Margin="0,8,16,0" Padding="6,4" CornerRadius="12"
               BackgroundColor="{AppThemeBinding Light=#FF5252, Dark=#FF6B6B}"
               BorderColor="Transparent" HasShadow="True" IsVisible="{Binding HasNotifications}"
               InputTransparent="True">
            <Label Text="!" FontSize="12" FontAttributes="Bold" TextColor="White"/>
        </Frame>

        <!-- Tabs de días estilo pill -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}">
            <HorizontalStackLayout x:Name="DayTabsContainer"
                                   Spacing="8" Padding="16,8"
                                   HorizontalOptions="Start"/>
        </ScrollView>

        <!-- Lista de cards -->
        <ScrollView Grid.Row="2" Orientation="Vertical"
                    VerticalScrollBarVisibility="Always"
                    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">
            <VerticalStackLayout x:Name="CardsContainer"
                                 Spacing="12" Padding="16"
                                 VerticalOptions="Start"/>
        </ScrollView>

        <!-- FAB para agregar -->
        <Button Grid.Row="2" Text="+"
                FontSize="28" FontAttributes="Bold"
                WidthRequest="56" HeightRequest="56" CornerRadius="16"
                BackgroundColor="{x:Static config:AppConstants.Accent}"
                TextColor="White"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,16,16"
                Clicked="OnAddScheduleClicked"
                Shadow="{Shadow Brush='Black', Opacity=0.3, Offset='0,2', Radius=4}"/>

        <!-- Barra de navegación inferior -->
        <controls:BottomNavView Grid.Row="3" ActiveTab="Schedule"/>
    </Grid>
</ContentPage>
