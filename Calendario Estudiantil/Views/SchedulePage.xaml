<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
              xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
              x:Class="Calendario_Estudiantil.Views.SchedulePage"
              Title="Calendario"
              Padding="0"
              NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header calendario -->
        <Frame Grid.Row="0" Padding="14,10" CornerRadius="0"
               BackgroundColor="{x:Static config:AppConstants.Accent}"
               BorderColor="Transparent" HasShadow="False">
            <Label Text="📅 Calendario" FontSize="20" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>
        </Frame>

        <!-- Navegación de semana -->
        <Frame Grid.Row="1" Margin="5,5,5,5" Padding="8" CornerRadius="12"
               BackgroundColor="{x:Static config:AppConstants.AccentLight}"
               BorderColor="Transparent" HasShadow="False">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="◀" Clicked="OnPreviousWeek"
                        WidthRequest="40" HeightRequest="36" CornerRadius="8"
                        BackgroundColor="{x:Static config:AppConstants.Accent}"
                        TextColor="White" FontSize="14" VerticalOptions="Start"/>
                <Label Grid.Column="1" Text="{Binding WeekLabel}"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" HorizontalOptions="Center"/>
                <Button Grid.Column="2" Text="Hoy" Clicked="OnGoToToday"
                        HeightRequest="36" CornerRadius="8" Padding="12,0"
                        BackgroundColor="{x:Static config:AppConstants.Accent}"
                        TextColor="White" FontSize="13" FontAttributes="Bold"/>
                <Button Grid.Column="3" Text="▶" Clicked="OnNextWeek"
                        WidthRequest="40" HeightRequest="36" CornerRadius="8"
                        BackgroundColor="{x:Static config:AppConstants.Accent}"
                        TextColor="White" FontSize="14" VerticalOptions="Start"/>
            </Grid>
        </Frame>

        <!-- Grid de horarios -->
        <ScrollView Grid.Row="2" Orientation="Vertical" VerticalScrollBarVisibility="Always">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <Grid x:Name="GridContainer" HorizontalOptions="Start" VerticalOptions="Start"/>
            </ScrollView>
        </ScrollView>

        <!-- Barra de navegación inferior reutilizable -->
        <controls:BottomNavView Grid.Row="3" ActiveTab="Schedule"/>
    </Grid>
</ContentPage>
