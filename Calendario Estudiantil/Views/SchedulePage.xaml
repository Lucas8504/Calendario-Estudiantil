<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Calendario_Estudiantil.ViewModels"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             x:Class="Calendario_Estudiantil.Views.SchedulePage"
             Title="Calendario">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navegación de semana -->
        <Frame Grid.Row="0" Margin="5,5,5,10" Padding="8" CornerRadius="12"
               BackgroundColor="{x:Static config:AppConstants+Theme.AccentLight}"
               BorderColor="Transparent" HasShadow="False">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Anterior -->
                <Button Grid.Column="0" Text="◀" Clicked="OnPreviousWeek"
                        WidthRequest="40" HeightRequest="36" CornerRadius="8"
                        BackgroundColor="{x:Static config:AppConstants+Theme.Accent}"
                        TextColor="White" FontSize="14"
                        VerticalOptions="Start"/>

                <!-- Semana actual -->
                <Label Grid.Column="1" Text="{Binding WeekLabel}"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{x:Static config:AppConstants+Theme.Accent}"
                       VerticalOptions="Center" HorizontalOptions="Center"/>

                <!-- Hoy -->
                <Button Grid.Column="2" Text="Hoy" Clicked="OnGoToToday"
                        HeightRequest="36" CornerRadius="8" Padding="12,0"
                        BackgroundColor="{x:Static config:AppConstants+Theme.Accent}"
                        TextColor="White" FontSize="13" FontAttributes="Bold"/>

                <!-- Siguiente -->
                <Button Grid.Column="3" Text="▶" Clicked="OnNextWeek"
                        WidthRequest="40" HeightRequest="36" CornerRadius="8"
                        BackgroundColor="{x:Static config:AppConstants+Theme.Accent}"
                        TextColor="White" FontSize="14"
                        VerticalOptions="Start"/>
            </Grid>
        </Frame>

        <!-- Encabezados de días (construido dinámicamente) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
            <HorizontalStackLayout x:Name="HeadersRow" Spacing="2" Padding="0"/>
        </ScrollView>

        <!-- Grid de horarios con scroll bidirectional -->
        <Grid Grid.Row="2">
            <!-- Scroll vertical para las horas -->
            <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Always">
                <!-- Scroll horizontal para los días -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                    <Grid x:Name="GridContainer"/>
                </ScrollView>
            </ScrollView>
        </Grid>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

        <!-- Barra de navegación inferior -->
        <Frame Grid.Row="3" Margin="0,5,0,0" Padding="0" CornerRadius="12"
               BackgroundColor="{x:Static config:AppConstants+Theme.AccentLight}"
               BorderColor="Transparent" HasShadow="False">
            <Grid ColumnSpacing="0" HeightRequest="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Calendario (activo) -->
                <Button Grid.Column="0" Text="📅 Calendario"
                        Clicked="OnNavigateSchedule"
                        BackgroundColor="Transparent"
                        TextColor="{x:Static config:AppConstants+Theme.Accent}"
                        FontSize="12" FontAttributes="Bold"
                        CornerRadius="0" HeightRequest="48"/>

                <!-- Separador -->
                <BoxView Grid.Column="0" VerticalOptions="End"
                         HeightRequest="3" Margin="15,0"
                         BackgroundColor="{x:Static config:AppConstants+Theme.Accent}"/>

                <!-- Tareas -->
                <Button Grid.Column="1" Text="📋 Tareas"
                        Clicked="OnNavigateTasks"
                        BackgroundColor="Transparent"
                        TextColor="#666666" FontSize="12"
                        CornerRadius="0" HeightRequest="48"/>

                <!-- Materias -->
                <Button Grid.Column="2" Text="📚 Materias"
                        Clicked="OnNavigateSubjects"
                        BackgroundColor="Transparent"
                        TextColor="#666666" FontSize="12"
                        CornerRadius="0" HeightRequest="48"/>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>