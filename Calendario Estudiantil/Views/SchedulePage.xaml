<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Calendario_Estudiantil.ViewModels"
             x:Class="Calendario_Estudiantil.Views.SchedulePage"
             Title="Calendario">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navegación de semana -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,5,0,10" HorizontalOptions="Center">
            <Button Text="◀" Clicked="OnPreviousWeek" WidthRequest="40" HeightRequest="36"/>
            <Label Text="{Binding WeekLabel}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
            <Button Text="Hoy" Clicked="OnGoToToday" HeightRequest="36"/>
            <Button Text="▶" Clicked="OnNextWeek" WidthRequest="40" HeightRequest="36"/>
        </HorizontalStackLayout>

        <!-- Encabezados de días (construido dinámicamente) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
            <HorizontalStackLayout x:Name="HeadersRow" Spacing="2" Padding="0"/>
        </ScrollView>

        <!-- Grid de horarios con scroll bidirectional -->
        <Grid Grid.Row="2">
            <!-- Scroll vertical para las horas -->
            <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Always">
                <!-- Scroll horizontal para los días -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                    <Grid x:Name="GridContainer"/>
                </ScrollView>
            </ScrollView>
        </Grid>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>