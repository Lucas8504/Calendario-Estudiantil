<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             xmlns:controls="clr-namespace:Calendario_Estudiantil.Controls"
             x:Class="Calendario_Estudiantil.Views.SchedulePage"
             Title="Calendario"
             Padding="0"
             NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header limpio -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar circular -->
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       Padding="0" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{x:Static config:AppConstants.Accent}"
                       VerticalOptions="Center" Margin="0,0,12,0">
                    <Label Text="C" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                
                <!-- Título y subtítulo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Calendario" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                    <Label Text="CICLO LECTIVO 2026" FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#707070}"/>
                </VerticalStackLayout>
                
                <!-- Ícono búsqueda -->
                <Button Grid.Column="2" Text="🔍" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        FontSize="18" Padding="0" TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"
                        Clicked="OnSearchClicked"/>
                
                <!-- Ícono configuración -->
                <Button Grid.Column="3" Text="⚙" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        FontSize="20" Padding="0" TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"
                        Clicked="OnSettingsClicked"/>
            </Grid>
        </Frame>

        <!-- Barra de búsqueda (oculta por defecto) -->
        <Frame Grid.Row="1" x:Name="SearchBarFrame" IsVisible="False"
               Margin="16,0,16,8" Padding="12,8" CornerRadius="12"
               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" BorderColor="Transparent" HasShadow="False">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Entry Grid.Column="0" x:Name="SearchEntry" 
                       Placeholder="Buscar materia o horario..."
                       Text="{Binding SearchQuery}"
                       TextChanged="OnSearchTextChanged"
                       FontSize="14" BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                
                <Button Grid.Column="1" Text="✕" 
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"
                        WidthRequest="32" HeightRequest="32" CornerRadius="16"
                        FontSize="14" Padding="0"
                        Clicked="OnClearSearchClicked"/>
            </Grid>
        </Frame>

        <!-- Tabs de días estilo pill -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <HorizontalStackLayout x:Name="DayTabsContainer" 
                                   Spacing="8" Padding="16,8"
                                   HorizontalOptions="Start"/>
        </ScrollView>

        <!-- Lista de cards -->
        <ScrollView Grid.Row="3" Orientation="Vertical" 
                    VerticalScrollBarVisibility="Always"
                    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">
            <VerticalStackLayout x:Name="CardsContainer" 
                                 Spacing="12" Padding="16"
                                 VerticalOptions="Start"/>
        </ScrollView>

        <!-- FAB para agregar -->
        <Button Grid.Row="3" Text="+" 
                FontSize="28" FontAttributes="Bold"
                WidthRequest="56" HeightRequest="56" CornerRadius="16"
                BackgroundColor="{x:Static config:AppConstants.Accent}"
                TextColor="White"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,16,16"
                Clicked="OnAddScheduleClicked"
                Shadow="{Shadow Brush='Black', Opacity=0.3, Offset='0,2', Radius=4}"/>

        <!-- Barra de navegación inferior -->
        <controls:BottomNavView Grid.Row="4" ActiveTab="Schedule"/>
    </Grid>
</ContentPage>
