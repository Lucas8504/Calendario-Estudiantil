<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Calendario_Estudiantil.ViewModels"
             xmlns:conv="clr-namespace:Calendario_Estudiantil.Converters"
             x:Class="Calendario_Estudiantil.Views.SchedulePage"
             Title="Calendario">

    <ContentPage.Resources>
        <conv:HexToColorConverter x:Key="HexToColorConverter"/>
        <conv:BoolToClassColorConverter x:Key="BoolToClassColorConverter"/>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </ContentPage.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navegación de semana -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,5,0,10" HorizontalOptions="Center">
            <Button Text="◀" Clicked="OnPreviousWeek" WidthRequest="40" HeightRequest="36"/>
            <Label Text="{Binding CurrentWeekStart, StringFormat='{}{0:dd/MM} - '}" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CurrentWeekStart, StringFormat='Semana del {0:dd/MM}'}" FontSize="16" FontAttributes="Bold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Text="Hoy" Clicked="OnGoToToday" HeightRequest="36"/>
            <Button Text="▶" Clicked="OnNextWeek" WidthRequest="40" HeightRequest="36"/>
        </HorizontalStackLayout>

        <!-- Encabezados de días -->
        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame WidthRequest="50" Margin="2" Padding="5"
                               BackgroundColor="{Binding IsToday, Converter={StaticResource BoolToColorConverter}}"
                               CornerRadius="8">
                            <StackLayout HorizontalOptions="Center">
                                <Label Text="{Binding DayName}" FontSize="12" HorizontalOptions="Center"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding DayNumber}" FontSize="16" HorizontalOptions="Center"
                                       FontAttributes="Bold" TextColor="#333"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Grid de horarios -->
        <ScrollView Grid.Row="2" Orientation="Vertical">
            <ScrollView Orientation="Horizontal">
                <StackLayout Orientation="Horizontal">
                
                <!-- Primera columna: horas -->
                <VerticalStackLayout WidthRequest="50">
                    <!-- Header vacío -->
                    <Border BackgroundColor="#EEEEEE" HeightRequest="50" Margin="1">
                        <Label Text="Hora" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11"/>
                    </Border>
                    <!-- Filas de horas -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeekDays[0].TimeSlots}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F5F5F5" HeightRequest="60" Margin="1">
                                    <Label Text="{Binding TimeDisplay}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           FontSize="11" TextColor="#666"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Columnas de días -->
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout WidthRequest="55">
                                <!-- Los slots de tiempo -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TimeSlots}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border HeightRequest="60" Margin="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#FAFAFA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding HasClass}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{Binding Subject.ColorHex, Converter={StaticResource HexToColorConverter}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <!-- Nombre de la materia si hay clase -->
                                                    <Label Text="{Binding Subject.Name}"
                                                           FontSize="10"
                                                           TextColor="White"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"
                                                           HorizontalTextAlignment="Center"
                                                           IsVisible="{Binding HasClass}"
                                                           Margin="2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </StackLayout>
            </ScrollView>
        </ScrollView>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsLoading}" 
                           HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>