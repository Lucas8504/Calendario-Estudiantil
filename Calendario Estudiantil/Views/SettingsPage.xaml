<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:config="clr-namespace:Calendario_Estudiantil.Configuration"
             x:Class="Calendario_Estudiantil.Views.SettingsPage"
             Title="Configuración"
             Padding="0"
             NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Frame Grid.Row="0" Padding="16,12" CornerRadius="0"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}"
               BorderColor="Transparent" HasShadow="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón volver -->
                <Button Grid.Column="0" BackgroundColor="Transparent"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Padding="0"
                        Clicked="OnBackClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF15C;" FontFamily="FluentIcons"
                                         Color="{AppThemeBinding Light=#666666, Dark=#A0A0A0}" Size="20"/>
                    </Button.ImageSource>
                </Button>

                <!-- Título -->
                <Label Grid.Column="1" Text="Configuración" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}" VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Contenido -->
        <ScrollView Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Sección de tema -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}" CornerRadius="12" Padding="16"
                       HasShadow="True" BorderColor="Transparent">
                    <Frame.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="4"/>
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tema de la aplicación" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                        <Label Text="Selecciona cómo quieres ver la aplicación" FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>

                        <!-- Botones de tema -->
                        <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                            <!-- Opción: Claro -->
                            <Button x:Name="BtnLight" Text="☀️ Claro" FontSize="16" FontAttributes="Bold"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                    CornerRadius="12" Padding="16"
                                    BorderColor="{x:Static config:AppConstants.Accent}" BorderWidth="2"
                                    HorizontalOptions="Fill"
                                    Clicked="OnThemeClicked" CommandParameter="Light"/>

                            <!-- Opción: Oscuro -->
                            <Button x:Name="BtnDark" Text="🌙 Oscuro" FontSize="16"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                    CornerRadius="12" Padding="16"
                                    BorderColor="Transparent" BorderWidth="2"
                                    HorizontalOptions="Fill"
                                    Clicked="OnThemeClicked" CommandParameter="Dark"/>

                            <!-- Opción: Sistema -->
                            <Button x:Name="BtnSystem" Text="📱 Sistema" FontSize="16"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                    CornerRadius="12" Padding="16"
                                    BorderColor="Transparent" BorderWidth="2"
                                    HorizontalOptions="Fill"
                                    Clicked="OnThemeClicked" CommandParameter="System"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Asistente de voz -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}" CornerRadius="12" Padding="16"
                       HasShadow="True" BorderColor="Transparent">
                    <Frame.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="4"/>
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Asistente de voz" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                        <Label Text="Pegá tu API key de Google Gemini para usar el micrófono. Se guarda cifrada en este dispositivo."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>

                        <Entry x:Name="GeminiKeyEntry"
                               Placeholder="AIza..."
                               IsPassword="True"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                               PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#707070}"/>

                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="SaveApiKeyButton" Text="Guardar" FontSize="14" FontAttributes="Bold"
                                    BackgroundColor="{x:Static config:AppConstants.Accent}"
                                    TextColor="White" CornerRadius="10" Padding="16,10"
                                    Clicked="OnSaveApiKeyClicked"/>
                            <Button x:Name="ClearApiKeyButton" Text="Borrar" FontSize="14"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                    CornerRadius="10" Padding="16,10"
                                    Clicked="OnClearApiKeyClicked"/>
                        </HorizontalStackLayout>

                        <Label x:Name="ApiKeyStatusLabel" FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Información de la app -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#151515}" CornerRadius="12" Padding="16"
                       HasShadow="True" BorderColor="Transparent">
                    <Frame.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="4"/>
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Calendario Estudiantil" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                        <Label Text="Versión 1.0.0" FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#A0A0A0}"/>
                        <Label Text="Luks.dev dedicado a Joaquin Araujo Leiva" FontSize="12"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#707070}"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
