<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendario_Estudiantil.Views.NewTaskPage"
             Title="Nueva Tarea">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <VerticalStackLayout Grid.Row="0" Margin="0,0,0,15">
            <Label Text="Título" FontSize="Medium" FontAttributes="Bold"/>
            <Entry x:Name="TitleEntry" Placeholder="Nombre de la tarea" MaxLength="100"/>
        </VerticalStackLayout>

        <!-- Descripción -->
        <VerticalStackLayout Grid.Row="1" Margin="0,0,0,15">
            <Label Text="Descripción" FontSize="Medium" FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor" Placeholder="Descripción opcional" HeightRequest="80"/>
        </VerticalStackLayout>

        <!-- Materia -->
        <VerticalStackLayout Grid.Row="2" Margin="0,0,0,15">
            <Label Text="Materia" FontSize="Medium" FontAttributes="Bold"/>
            <Picker x:Name="SubjectPicker" Title="Seleccionar materia"/>
        </VerticalStackLayout>

        <!-- Fecha de vencimiento -->
        <VerticalStackLayout Grid.Row="3" Margin="0,0,0,15">
            <Label Text="Fecha de vencimiento" FontSize="Medium" FontAttributes="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="DueDatePicker" Grid.Column="0"/>
                <TimePicker x:Name="DueTimePicker" Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Notificación -->
        <VerticalStackLayout Grid.Row="4" Margin="0,0,0,15">
            <Label Text="Notificar antes (horas)" FontSize="Medium" FontAttributes="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Entry x:Name="NotificationHoursEntry" Grid.Column="0" 
                       Text="24" Keyboard="Numeric" MaxLength="3"/>
                <Label Grid.Column="1" Text="horas antes" VerticalOptions="Center" Margin="10,0,0,0"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Botones -->
        <HorizontalStackLayout Grid.Row="7" Spacing="10" HorizontalOptions="Center">
            <Button Text="Cancelar" Clicked="OnCancel" WidthRequest="120"/>
            <Button Text="Crear" Clicked="OnSave" WidthRequest="120" BackgroundColor="#4CAF50"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>